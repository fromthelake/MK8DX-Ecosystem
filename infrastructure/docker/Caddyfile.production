{$MK8DX_DOMAIN} {
  encode zstd gzip
  @api path /api/* /v1/* /health/*
  handle @api {
    # The API rate-limits sign-ins per client: hand it the connecting address,
    # replacing any client-supplied X-Real-IP. (With no trusted proxy list Caddy
    # already rewrites X-Forwarded-For to the connecting address.)
    reverse_proxy api:8080 {
      header_up X-Real-IP {remote_host}
    }
  }
  handle /.well-known/assetlinks.json {
    root * /srv
    header Content-Type application/json
    file_server
  }
  handle /client-config.json {
    root * /srv
    header Content-Type application/json
    file_server
  }
  handle_path /scanner/* {
    root * /srv/scanner
    file_server
    header Cross-Origin-Opener-Policy same-origin
    header Cross-Origin-Embedder-Policy require-corp
    header Cross-Origin-Resource-Policy same-origin
  }
  handle /assets/* {
    root * /srv
    file_server
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  # Scanner CSP in three non-overlapping parts (#34). Only the Vite worker entries under
  # assets/worker/ get 'unsafe-eval': OpenCV.js (Emscripten/embind) builds functions with
  # new Function. A worker loaded from a URL runs under its own response's policy, so the
  # page never allows eval. ONNX Runtime threads and the Tesseract worker only compile WASM.
  @scanner_worker_csp path /scanner/assets/worker/*
  @scanner_wasm_csp path /scanner/ort/* /scanner/tess/*
  @scanner_csp {
    path /scanner/*
    not path /scanner/assets/worker/* /scanner/ort/* /scanner/tess/*
  }
  @web_csp not path /scanner/*
  header @scanner_csp Content-Security-Policy "default-src 'self'; connect-src 'self'; font-src 'self'; img-src 'self' blob: data:; script-src 'self'; style-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
  header @scanner_wasm_csp Content-Security-Policy "default-src 'none'; connect-src 'self'; img-src 'self' blob: data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
  header @scanner_worker_csp Content-Security-Policy "default-src 'none'; connect-src 'self'; img-src 'self' blob: data:; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
  header @web_csp Content-Security-Policy "default-src 'self'; connect-src 'self'; font-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
  header X-Content-Type-Options nosniff
  header Referrer-Policy same-origin
  header X-Frame-Options DENY
  header Strict-Transport-Security "max-age=31536000"
}

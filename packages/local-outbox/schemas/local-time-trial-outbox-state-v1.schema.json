{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mk8dx.example/schemas/local-outbox/local-time-trial-outbox-state-v1.schema.json",
  "title": "LocalTimeTrialOutboxStateV1",
  "description": "One immutable revision in a local canonical-delivery state chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entryKey",
    "stateRevision",
    "state",
    "attemptCount",
    "updatedAtMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mk8dx.local-time-trial-outbox-state.v1"
    },
    "entryKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999999999
    },
    "state": {
      "enum": ["pending", "failed", "synced"]
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999
    },
    "updatedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999
    },
    "lastAttemptAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999
    },
    "failureCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "syncedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"state": {"const": "pending"}},
        "required": ["state"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["lastAttemptAtMs"]},
            {"required": ["failureCode"]},
            {"required": ["syncedAtMs"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"state": {"const": "failed"}},
        "required": ["state"]
      },
      "then": {
        "required": ["lastAttemptAtMs", "failureCode"],
        "not": {"required": ["syncedAtMs"]}
      }
    },
    {
      "if": {
        "properties": {"state": {"const": "synced"}},
        "required": ["state"]
      },
      "then": {
        "required": ["lastAttemptAtMs", "syncedAtMs"],
        "not": {"required": ["failureCode"]}
      }
    }
  ]
}

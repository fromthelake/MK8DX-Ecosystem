{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mk8dx.example/schemas/local-outbox/local-private-evidence-v1.schema.json",
  "title": "LocalPrivateEvidenceV1",
  "description": "Source-specific private local metadata linked by a deterministic outbox entry key. Media bytes are stored separately and never embedded in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entryKey", "createdAtMs", "privateEvidence"],
  "properties": {
    "schemaVersion": {
      "const": "mk8dx.local-private-evidence.v1"
    },
    "entryKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "createdAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999
    },
    "privateEvidence": {
      "type": "object",
      "maxProperties": 64
    }
  }
}

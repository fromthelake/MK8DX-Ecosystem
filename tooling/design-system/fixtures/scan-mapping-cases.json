{
  "version": "mk8dx.scan-mapping-cases.v1",
  "note": "What a producer read, and what the canonical Post-a-Time draft makes of it (POST_A_TIME_ARCHITECTURE §3/§11, ADR-0204, ADR-0206). The scanner writes `handoff`; the scan service maps it to `fill`; applying that fill to a blank draft gives `draft`. One file, so the reader of a screen and the form that publishes it cannot drift apart quietly.",
  "cases": [
    {
      "id": "result-screen-three-laps",
      "note": "The ordinary case: the end screen, everything read, nothing doubted.",
      "handoff": {
        "trackId": "track.mario_kart_stadium",
        "mode": 150,
        "totalDigits": "145912",
        "laps": ["035392", "035300", "035220"],
        "characterId": "character.mario",
        "layout": "endscreen",
        "producerVersion": "tt-scan-web/0.4.1-web.2",
        "confidence": { "character": 0.93 },
        "lapSumMatches": true
      },
      "fill": {
        "totalDigits": "145912",
        "laps": ["035392", "035300", "035220"],
        "characterId": "character.mario",
        "source": "endscreen",
        "producerVersion": "tt-scan-web/0.4.1-web.2",
        "confidence": { "character": 0.93 },
        "lapSumMatches": true
      },
      "draft": {
        "totalDigits": "145912",
        "lapDigits": ["035392", "035300", "035220"],
        "scanned": [
          "totalDigits",
          "laps[0].timeDigits",
          "laps[1].timeDigits",
          "laps[2].timeDigits",
          "loadout.characterId"
        ],
        "doubt": [],
        "captureLayout": "time_trial_result",
        "sourceKind": "web_scan",
        "verificationStatus": "producer_check_passed"
      }
    },
    {
      "id": "ghost-panel-total-only",
